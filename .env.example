# ─────────────────────────────────────────────────────────────
# Arrowstack Task 1 — JWT Auth Microservice · Environment Config
# Ref: AS-2026-7346 · Bhumika Gandhi
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT secrets (change these in production!)
JWT_ACCESS_SECRET=arrowstack_2026_access_secret_bhumika_7346_change_me_in_prod
JWT_REFRESH_SECRET=arrowstack_2026_refresh_secret_bhumika_7346_change_me_in_prod

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database (SQLite — file stored in /data)
DB_PATH=./data/auth.db
